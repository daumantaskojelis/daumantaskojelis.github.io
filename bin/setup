#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${project_root}"

# shellcheck source=ruby-env
source "${project_root}/bin/ruby-env"

if ! gem list --installed --exact bundler --version "${PROJECT_BUNDLER_VERSION}" >/dev/null 2>&1; then
  echo "Installing Bundler ${PROJECT_BUNDLER_VERSION}..."
  gem install bundler --version "${PROJECT_BUNDLER_VERSION}" --no-document
fi

project_bundle config set --local path vendor/bundle
project_bundle install

echo
echo "Setup complete. Start the site with: make serve"
